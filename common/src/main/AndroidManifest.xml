<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- BYD's file picker runs as the system user and cannot grant a picked local MFi document, so it is read from its path. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Also declared by :shared; the car video player logs whether the head unit is online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updates without the head unit's ADB: the system installer, where Android lets this app open it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11 and later: the apps that can open an update APK, and BYD's file manager. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <package android:name="com.byd.filemanager" />
    </queries>

    <!-- Android 10 head units: direct file reads for local MFi documents (ignored on later versions). -->
    <application android:requestLegacyExternalStorage="true">

        <provider
            android:name="com.shilapi.xcertplay.update.UpdateApkProvider"
            android:authorities="${applicationId}.update-apks"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_apk_paths" />
        </provider>

        <activity
            android:name="com.shilapi.xcertplay.CarPlayHostActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The MFi USB adapter attaches at every BYD power-on; it opens CarPlay only with auto-start. -->
        <activity
            android:name="com.shilapi.xcertplay.UsbAttachActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <activity
            android:name="com.shilapi.xcertplay.CarPlayVideoActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.ImageCropActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay" />

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
